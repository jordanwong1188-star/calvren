/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/admin*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/operator*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/try-demo*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
/lead-demo*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# These public demo scripts have stable URLs. Revalidate after every new Pages build
# rather than replaying an old booking-calendar module from the browser cache.
/lead-demo.js
  Cache-Control: no-cache, must-revalidate
/demo-access.js
  Cache-Control: no-cache, must-revalidate
/conversion/*
  Cache-Control: no-cache, must-revalidate

# Public form logic changes with deployments and must not remain stale.
/shared.js
  Cache-Control: no-cache, must-revalidate
