# Frontend-safe values
# No credential or VITE_/PUBLIC_ variable is required by this static frontend.
# The browser demo uses illustrative business data and simulated providers only.

# Server-only configuration: local .env, or Netlify > Environment variables.
# Set secrets with Functions scope and Production context; redeploy after changes.
# Default is simulation. Live processing is enabled only in production with complete setup.
CALVREN_AUTOMATION_MODE=demo
CALVREN_PUBLIC_URL=https://calvren.netlify.app

# Operator authentication: generate a long random token; never use a public demo value.
CALVREN_ADMIN_TOKEN=

# Dedicated Calvren Supabase project; run supabase/migrations/202610030001_calvren_conversion.sql.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# AI processing (server only). Browser demo does not call OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio account for live SMS. Each client config supplies its own receiving/sending number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Calendar API service account. Share each client's calendar with this account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Use the complete PEM private key, including BEGIN/END lines; escaped \\n is supported.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Live business notification emails through Resend; sender/domain must be verified.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Existing Calvren marketing enquiry inbox: retain its production data guard.
CALVREN_DATA_ENV=production

# Cloudflare Pages: public routing/build settings; never put provider secrets here.
CALVREN_BACKEND_URL=https://xjfsukhfmkgvlfpgjevg.supabase.co/functions/v1/calvren
# Set this to your actual production Pages/custom-domain origin in Cloudflare build settings.
CALVREN_SITE_URL=

# Supabase Edge Function secrets: the same server credentials above belong here after migration.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.
# Set a new random 32+ character value here AND in GitHub Actions secrets to enable the scheduler.
CALVREN_CRON_TOKEN=
# GitHub Actions secret for automatic backend deployment (not a frontend or function setting).
# SUPABASE_ACCESS_TOKEN is generated in the Supabase account's Access Tokens page.
